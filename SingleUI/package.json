{
  "name": "single-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node scripts/app.mjs serve",
    "build": "node scripts/app.mjs build",
    "build:apps": "node scripts/build-apps.mjs",
    "package:apps": "node scripts/package-apps.mjs",
    "test:artifacts": "node --test scripts/artifacts.test.mjs",
    "test:bundles": "node --test scripts/bundle-isolation.test.mjs",
    "watch": "node scripts/app.mjs build --watch --configuration development",
    "test": "node scripts/app.mjs test",
    "test:launcher": "node --test scripts/app.test.mjs",
    "build:ui": "node scripts/build-ui.mjs",
    "palette": "node scripts/palette.mjs",
    "test:ui": "node scripts/palette.mjs --check && npm run build:ui && node --test scripts/build-ui.test.mjs",
    "test:browser": "npm run build:ui && playwright test",
    "skins:prepare": "npm run build:ui && node deployment/local/prepare.mjs",
    "skins:up": "docker compose --env-file .local/skins.env -f deployment/local/compose.yml up -d --build --force-recreate note storage",
    "test:hosts": "playwright test --config=playwright.hosts.config.mjs",
    "test:hosts:isolated": "npm run build:ui && node deployment/local/test-isolated.mjs",
    "skins:down": "docker compose --env-file .local/skins.env -f deployment/local/compose.yml down"
  },
  "private": true,
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || ^24.0.0",
    "npm": ">=10.8.2 <11"
  },
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "lucide": "^0.577.0",
    "marked": "^16.4.2",
    "rxjs": "~7.8.0",
    "three": "^0.180.0",
    "tslib": "^2.3.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.27",
    "@angular/cli": "^21.2.27",
    "@angular/compiler-cli": "^21.2.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/three": "^0.180.0",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2",
    "vitest": "~4.0.8"
  }
}
